{
  "info": {
    "name": "CCS User Management API",
    "description": "REST API for the CCS developer challenge. Run `docker compose up -d` and `python manage.py runserver` before using this collection.\n\nStart with **Auth > Login as admin**: it stores the tokens in collection variables automatically, so every other request is already authenticated.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "person_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.access);",
                  "pm.collectionVariables.set('refresh_token', body.refresh);",
                  "pm.collectionVariables.set('person_id', body.person_id);",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('role is ADMIN', () => pm.expect(body.role).to.eql('ADMIN'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login",
                ""
              ]
            },
            "description": "Full access: can create, update and delete people."
          }
        },
        {
          "name": "Login as user123 (read only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.access);",
                  "pm.collectionVariables.set('refresh_token', body.refresh);",
                  "pm.collectionVariables.set('person_id', body.person_id);",
                  "",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('role is USER', () => pm.expect(body.role).to.eql('USER'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user123\",\n  \"password\": \"Password1!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login",
                ""
              ]
            },
            "description": "Read-only account. Write requests return 403."
          }
        },
        {
          "name": "Login with wrong password (401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"WrongPassword\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login",
                ""
              ]
            }
          }
        },
        {
          "name": "Refresh access token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('access_token', body.access);",
                  "if (body.refresh) { pm.collectionVariables.set('refresh_token', body.refresh); }"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "token",
                "refresh",
                ""
              ]
            },
            "description": "Rotates the refresh token. The previous one is blacklisted, so replaying it returns 401."
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/logout/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout",
                ""
              ]
            },
            "description": "Blacklists the refresh token immediately."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "List people",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ]
            },
            "description": "Paginated, 10 per page."
          }
        },
        {
          "name": "List people - page 2",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/?page=2",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                }
              ]
            }
          }
        },
        {
          "name": "Search people",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/?search=Japan",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ],
              "query": [
                {
                  "key": "search",
                  "value": "Japan"
                }
              ]
            },
            "description": "Searches first_name, last_name, email and country."
          }
        },
        {
          "name": "Sort people",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/?ordering=-country",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ],
              "query": [
                {
                  "key": "ordering",
                  "value": "-country"
                }
              ]
            }
          }
        },
        {
          "name": "Retrieve a person",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/1/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "1",
                ""
              ]
            }
          }
        },
        {
          "name": "Create a person",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('created_id', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Nuevo\",\n  \"last_name\": \"Registro\",\n  \"email\": \"nuevo.registro@example.com\",\n  \"phone\": \"+51 999 111 222\",\n  \"country\": \"Peru\",\n  \"birth_date\": \"1999-02-10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ]
            },
            "description": "Requires an admin token. Returns 403 for user123."
          }
        },
        {
          "name": "Update a person",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Actualizado\",\n  \"last_name\": \"Registro\",\n  \"email\": \"nuevo.registro@example.com\",\n  \"phone\": \"+51 999 111 222\",\n  \"country\": \"Chile\",\n  \"birth_date\": \"1999-02-10\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/{{created_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{created_id}}",
                ""
              ]
            },
            "description": "PUT replaces the whole record, so every field is required."
          }
        },
        {
          "name": "Delete a person",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/{{created_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "{{created_id}}",
                ""
              ]
            },
            "description": "Returns 204 with no body."
          }
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "No token (401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ]
            }
          }
        },
        {
          "name": "Unknown id (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/9999/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "9999",
                ""
              ]
            }
          }
        },
        {
          "name": "Duplicate email (400)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ana\",\n  \"last_name\": \"Torres\",\n  \"email\": \"ana.torres@example.com\",\n  \"phone\": \"+51 987 654 321\",\n  \"country\": \"Peru\",\n  \"birth_date\": \"1990-03-14\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ]
            }
          }
        },
        {
          "name": "Invalid email format (400)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Test\",\n  \"last_name\": \"Invalid\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"+51 900 000 000\",\n  \"country\": \"Peru\",\n  \"birth_date\": \"1990-01-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ]
            }
          }
        },
        {
          "name": "Birth date in the future (400)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Test\",\n  \"last_name\": \"Future\",\n  \"email\": \"future@example.com\",\n  \"phone\": \"+51 900 000 000\",\n  \"country\": \"Peru\",\n  \"birth_date\": \"2190-01-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ]
            }
          }
        },
        {
          "name": "Missing required fields (400)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Solo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ]
            }
          }
        },
        {
          "name": "Write as user123 (403)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Denied\",\n  \"last_name\": \"Test\",\n  \"email\": \"denied@example.com\",\n  \"phone\": \"+51 900 000 000\",\n  \"country\": \"Peru\",\n  \"birth_date\": \"1990-01-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                ""
              ]
            },
            "description": "Run 'Login as user123' first so the stored token belongs to the read-only account."
          }
        },
        {
          "name": "Delete a person with an account (409)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/users/21/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users",
                "21",
                ""
              ]
            },
            "description": "Person 21 owns the admin account, so PROTECT blocks the delete."
          }
        }
      ]
    }
  ]
}
